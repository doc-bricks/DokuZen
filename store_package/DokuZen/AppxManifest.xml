<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="Geiger.DokuZen"
            Publisher="CN=52596601-BAB4-4F3F-B182-E8F3F273B202"
            Version="1.0.1.0" />

  <Properties>
    <DisplayName>DokuZen</DisplayName>
    <PublisherDisplayName>Geiger</PublisherDisplayName>
    <Description>Lokale Dokumenten-Werkstatt für PDF-Bearbeitung, OCR, Schwärzung, Konvertierung und Dateiverwaltung.</Description>
    <Logo>icons\icon_50x50.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE"/>
    <Resource Language="en-US"/>
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>

  </Capabilities>

  <Applications>
    <Application Id="DokuZenApp"
                 Executable="DokuZen-Pro-1.0.0-win64.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="DokuZen"
                          Description="Lokale Dokumenten-Werkstatt für PDF-Bearbeitung, OCR, Schwärzung, Konvertierung und Dateiverwaltung."
                          Square150x150Logo="icons\icon_150x150.png"
                          Square44x44Logo="icons\icon_44x44.png"
                          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="icons\icon_310x150.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>PDF-Dokument</uap:DisplayName>
            <uap:Logo>icons\icon_44x44.png</uap:Logo>
            <uap:InfoTip>Mit DokuZen öffnen</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap3:Extension Category="windows.appExecutionAlias"
                        Executable="DokuZen-Pro-1.0.0-win64.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="dokuzen.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
